# Public paper code only. Local research documents, logs, data, weights,
# manuscripts and archives are deliberately excluded.
/*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/THIRD_PARTY.md
!/requirements.txt
!/configs/
!/src/
!/scripts/
!/tests/

/configs/*
!/configs/experiments.json
!/configs/cifar100_split.json
!/configs/weights.json

/src/**
!/src/**/
!/src/**/*.py
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
.DS_Store
